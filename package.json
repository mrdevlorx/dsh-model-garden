{
  "name": "dsh-model-garden",
  "version": "0.7.0",
  "description": "A searchable, sortable model picker for the DeepSeek Harness Web UI — provider groups, favorites, hidden-models blacklist, live per-task cost, prices and context windows, plus a refresh button that re-syncs every provider model list from its live API.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "model-picker",
    "model-selection",
    "models.dev",
    "llm",
    "token-cost"
  ],
  "license": "MIT",
  "author": "mrdevlorx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdevlorx/dsh-model-garden.git"
  },
  "homepage": "https://github.com/mrdevlorx/dsh-model-garden#readme",
  "bugs": {
    "url": "https://github.com/mrdevlorx/dsh-model-garden/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/refresh-core.js",
    "lib/pi-catalog.js",
    "bin/refresh-models.mjs",
    "test/refresh-core.test.js",
    "test/refresh-endpoint.test.js",
    "test/cost-endpoint.test.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}